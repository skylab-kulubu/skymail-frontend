# Read by the server at runtime — the image is the same for sandbox and
# production. For local development copy this file to .env.local.

# Auth.js cookie encryption only; never sent to Keycloak. Generate with
#   openssl rand -base64 33
AUTH_SECRET=

# This site's public URL. Auth.js builds the Keycloak redirect URI from it
# (<AUTH_URL>/api/auth/callback/keycloak) and trusts the proxy's host headers
# once it is set. Leave empty locally.
#   production: https://mail.yildizskylab.com
#   sandbox:    https://sandbox-mail.yildizskylab.com
AUTH_URL=

# The Keycloak realm and the public client SkyMail signs in with (no secret).
#   production: https://e.yildizskylab.com/realms/e-skylab
#   sandbox:    https://e.yildizskylab.com/realms/e-skylab-sandbox
#
# As of 2026-09-23 the sandbox realm has NO skymail client (Keycloak answers
# "Client not found"), so signing in locally against sandbox cannot work yet,
# and the production client does not list the local addresses. One of these
# is a human step in Keycloak:
#   - create a public "skymail" client in e-skylab-sandbox, or
#   - add the local addresses to the production realm's "skymail" client,
# with, for a local run on port 3000:
#   Valid redirect URI:              http://localhost:3000/api/auth/callback/keycloak
#   Valid post logout redirect URI:  http://localhost:3000
#   Web origin:                      http://localhost:3000
KEYCLOAK_ISSUER=https://e.yildizskylab.com/realms/e-skylab-sandbox
KEYCLOAK_CLIENT_ID=skymail

# The SkyMail API the browser calls.
#   production: https://api.yildizskylab.com/api/skymail/v1
#   sandbox:    https://sandbox-api.yildizskylab.com/api/skymail/v1
API_URL=https://sandbox-api.yildizskylab.com/api/skymail/v1

# The other club consoles, for the club switcher. Unset means production.
#   production: https://admin.yildizskylab.com, https://forms.yildizskylab.com/admin
#   sandbox:    https://sandbox-admin.yildizskylab.com, https://sandbox-forms.yildizskylab.com/admin
ADMIN_URL=https://sandbox-admin.yildizskylab.com
FORMS_ADMIN_URL=https://sandbox-forms.yildizskylab.com/admin
