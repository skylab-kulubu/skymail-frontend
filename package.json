{
  "name": "skymail-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@babel/standalone": "^7.29.1",
    "@monaco-editor/react": "^4.7.0",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@tiptap/core": "^3.12.1",
    "@tiptap/extension-list": "^3.12.1",
    "@tiptap/extensions": "^3.12.1",
    "@tiptap/pm": "^3.12.1",
    "@tiptap/react": "^3.12.1",
    "@tiptap/starter-kit": "^3.12.1",
    "lucide-react": "^1.46.0",
    "monaco-editor": "0.55.1",
    "next": "^16.1.0",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^19.2.3",
    "recharts": "^3.7.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@next/eslint-plugin-next": "^16.1.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.30.1"
  },
  "scripts": {
    "dev": "tsx scripts/build-editor-assets.ts && next dev",
    "build": "tsx scripts/build-editor-assets.ts && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "api:check": "tsx --test \"src/**/*.test.ts\"",
    "emails:render": "tsx scripts/render-templates.ts",
    "emails:seed": "tsx scripts/seed-templates.ts",
    "emails:check": "tsx --test src/lib/mail-render/free-body.test.ts src/lib/mail-render/go-url.test.ts",
    "templates:check": "tsx --test \"src/lib/mail-render/*.test.ts\"",
    "editor:assets": "tsx scripts/build-editor-assets.ts",
    "test:e2e": "playwright test"
  },
  "packageManager": "yarn@4.14.1"
}
