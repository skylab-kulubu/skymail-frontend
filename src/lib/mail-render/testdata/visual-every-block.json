{
  "type": "skymail.visual",
  "version": 1,
  "blocks": [
    { "type": "heading", "content": [{ "type": "text", "text": "Merhaba " }, { "type": "variable", "name": "FirstName" }] },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "text": "GECEKODU bu yıl " },
        { "type": "text", "text": "12–13 Nisan", "marks": [{ "type": "bold" }] },
        { "type": "text", "text": "'da, " },
        { "type": "text", "text": "Davutpaşa", "marks": [{ "type": "italic" }] },
        { "type": "text", "text": " kampüsünde. Ayrıntılar " },
        { "type": "text", "text": "etkinlik sayfasında", "marks": [{ "type": "link", "href": "https://skyl.app/gecekodu" }] },
        { "type": "text", "text": ". Takımın: " },
        { "type": "variable", "name": "TeamName", "marks": [{ "type": "bold" }] }
      ]
    },
    { "type": "button", "label": "Bilete git", "link": { "variable": "TicketUrl" } },
    { "type": "heading", "content": [{ "type": "text", "text": "Program" }] },
    { "type": "paragraph", "content": [{ "type": "text", "text": "Açılış 10.00'da, kapanış ertesi gün 10.00'da." }] },
    { "type": "button", "label": "Programı gör", "link": { "url": "https://skyl.app/gecekodu/program" } },
    { "type": "image", "src": "https://cdn.yildizskylab.com/images/gecekodu-afis.png", "alt": "GECEKODU afişi", "width": 480 },
    { "type": "divider" },
    {
      "type": "conditional",
      "variable": "Venue",
      "when": "set",
      "blocks": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Yer: " }, { "type": "variable", "name": "Venue" }] }]
    },
    {
      "type": "conditional",
      "variable": "Venue",
      "when": "unset",
      "blocks": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Yer yakında duyurulacak." }] }]
    }
  ]
}
